{%- comment -%}
  Events page — "האירועים שלנו" gallery. docs/design-log.md, 2026-08-23.

  The twelve real event photos from the old Wix page, bundled at 800w
  (JPG + WebP). Column-based masonry: 2 columns at 375px, 3 from 768px —
  the mix of square and portrait shots keeps the wall lively without any
  cropping, and `break-inside: avoid` keeps each photo whole. Everything
  below the hero, so all images lazy-load with explicit dimensions.

  Replaceable from the theme editor: add image blocks and they render
  INSTEAD of the bundled set; zero blocks means the bundled twelve.
{%- endcomment -%}

{{ 'florista-events.css' | asset_url | stylesheet_tag }}
<script src="{{ 'florista-events.js' | asset_url }}" defer></script>

{%- liquid
  assign heading = section.settings.heading | default: 'חתונות ואירועים שעיצבנו'
  assign bundled = '01:800:800,02:800:800,03:800:800,04:800:800,05:800:800,06:800:800,07:800:1067,08:800:1067,09:800:1067,10:800:1067,11:800:1067,12:800:1067' | split: ','
-%}

<section class="fev-section fev-page">
  <div class="fev-inner">
    <h2 class="fev-heading" data-reveal>{{ heading }}</h2>
    <ul class="fev-gallery-grid" role="list">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.image -%}
            <li class="fev-gallery-item" {{ block.shopify_attributes }}>
              {{
                block.settings.image
                | image_url: width: 800
                | image_tag:
                  widths: '400, 800',
                  sizes: '(min-width: 768px) 30vw, 46vw',
                  loading: 'lazy',
                  alt: block.settings.image.alt | default: 'עיצוב פרחים לחתונה ולאירועים בעבודת פלוריסטה'
              }}
            </li>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        {%- for item in bundled -%}
          {%- liquid
            assign parts = item | split: ':'
            assign n = parts[0]
            assign w = parts[1]
            assign h = parts[2]
          -%}
          <li class="fev-gallery-item">
            <picture>
              <source type="image/webp" srcset="{{ 'events-gallery-' | append: n | append: '.webp' | asset_url }}">
              <img
                src="{{ 'events-gallery-' | append: n | append: '.jpg' | asset_url }}"
                width="{{ w }}" height="{{ h }}"
                loading="lazy"
                sizes="(min-width: 768px) 30vw, 46vw"
                alt="עיצוב פרחים לחתונה ולאירועים בעבודת פלוריסטה – תמונה {{ forloop.index }} מתוך {{ bundled.size }}">
            </picture>
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Events — gallery",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "כותרת", "default": "חתונות ואירועים שעיצבנו" }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "תמונה",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "תמונה" }
      ]
    }
  ],
  "presets": [{ "name": "Events — gallery" }]
}
{% endschema %}
