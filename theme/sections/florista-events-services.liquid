{%- comment -%}
  Events page — "השירותים שלנו". docs/design-log.md, 2026-08-23.

  The four paragraphs from the old Wix page, verbatim, with the closing
  invitation set as a pull line and the page's single CTA repeated under it.
  The CTA is the old Wix original, "עצבו לי את החתונה". It was briefly
  unified to "עצבו לי את האירוע" (2026-08-24); the 2026-08-26 rename of the
  page to חתונות restored the original — both CTAs on the page use it.
{%- endcomment -%}

{{ 'florista-events.css' | asset_url | stylesheet_tag }}
<script src="{{ 'florista-events.js' | asset_url }}" defer></script>

{%- liquid
  assign heading = section.settings.heading | default: 'השירותים שלנו'
  assign para_1 = section.settings.para_1 | default: 'בין אם אתם מדמיינים את כל האירוע ויודעים איך בדיוק אתם רוצים שהוא יראה, ובין אם אתם מגיעים עם ראש פתוח וביטחון – כשתכנסו למקום האירוע שלכם ותראו את התוצר הסופי, לא תצליחו למחוק את החיוך.'
  assign para_2 = section.settings.para_2 | default: 'אתם מוזמנים לשלוח לצוות המסור תמונות ורפרנסים מאירועים אחרים שראיתם ואהבתם, גם עיצובים מכל העולם, ויחד – תתאימו איתם את העיצוב המדויק לצרכים שלכם, עד לאישור הסופי שלכם.'
  assign para_3 = section.settings.para_3 | default: 'ביום האירוע, כל מה שיוותר לכם לעשות הוא ליהנות מהארגונים שלכם – סידור ועיצוב מקום האירוע, וכל הקשור אליו, הוא תחת אחריות פלוריסטה.'
  assign para_4 = section.settings.para_4 | default: 'לודמילה, בעלת העסק, מגיעה לבד או בליווי צוות מקצועי, כמה שעות טרם תחילת האירוע, על-מנת שהפרחים יהיו הטריים ביותר, ושם היא מסדרת את הפרחים יחד עם כל הכלים והציוד הרלוונטי לעיצוב האירוע שלכם – כולל מזכרת נעימה לאורחים שלכם.'
  assign pull = section.settings.pull | default: 'בואו לקשט את היום המרגש שלכם בפרחים טריים, צבעוניים וריחניים – אנחנו כאן, זמינים להקשיב, לתכנן ולעצב לכם את החלום'
  assign cta_label = section.settings.cta_label | default: 'עצבו לי את החתונה'
-%}

<section class="fev-section fev-page">
  <div class="fev-inner">
    <div class="fev-measure" data-reveal>
      <h2 class="fev-heading">{{ heading }}</h2>
      <div class="fev-body">
        <p>{{ para_1 }}</p>
        <p>{{ para_2 }}</p>
        <p>{{ para_3 }}</p>
        <p>{{ para_4 }}</p>
      </div>
    </div>
    <p class="fev-pull" data-reveal>{{ pull }}</p>
    <div class="fev-services-actions" data-reveal>
      <a class="fev-cta" href="#leave-details">{{ cta_label }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Events — services",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "כותרת", "default": "השירותים שלנו" },
    { "type": "textarea", "id": "para_1", "label": "פסקה 1" },
    { "type": "textarea", "id": "para_2", "label": "פסקה 2" },
    { "type": "textarea", "id": "para_3", "label": "פסקה 3" },
    { "type": "textarea", "id": "para_4", "label": "פסקה 4" },
    { "type": "textarea", "id": "pull", "label": "משפט הסיום המודגש" },
    { "type": "text", "id": "cta_label", "label": "טקסט הכפתור", "default": "עצבו לי את החתונה" }
  ],
  "presets": [{ "name": "Events — services" }]
}
{% endschema %}
