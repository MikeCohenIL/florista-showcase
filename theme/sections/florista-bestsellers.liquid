{%- comment -%}
  Best sellers — site-structure.md §8.4: הנמכרים ביותר, product grid + "טעינת
  מוצרים נוספים" (load more). Designed 2026-08-19, rebuilt in Liquid 2026-08-20,
  wired to the real catalog 2026-08-22.

  WHERE THE PRODUCTS COME FROM. The section renders a real Shopify collection —
  by default `best-sellers` (הנמכרים ביותר), which is seeded with the 24 products
  that actually sold best on Wix, floral only, in units-sold order. Nothing about
  that list lives in this file: reorder, add or remove in
  Products → Collections → הנמכרים ביותר and the homepage follows. A different
  collection can be pointed at the section from the theme editor.

  ORDER IS THE COLLECTION'S ORDER. The collection is on MANUAL sort today because
  this Shopify store has no order history of its own yet — Shopify's own
  "best selling" sort would return an arbitrary order on a store with zero sales.
  Once real orders accumulate, switch that collection's sort to **Best selling**
  in the admin and this section becomes self-maintaining. That is one dropdown,
  not a code change; do not re-implement ranking here.

  FALLBACK. If the collection is missing or empty, the eight static placeholder
  cards below render instead, with the load-more button disabled — the same empty
  state the brick was designed and QA'd against. They are not real SKUs.
{%- endcomment -%}

{{ 'florista-bestsellers.css' | asset_url | stylesheet_tag }}
{{ 'florista-ribbon.css' | asset_url | stylesheet_tag }}
<script src="{{ 'florista-bestsellers.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign bs_collection = section.settings.collection
  unless bs_collection
    assign bs_collection = collections['best-sellers']
  endunless

  assign page_size = section.settings.page_size
  assign max_products = section.settings.max_products

  assign total = bs_collection.products.size
  if total > max_products
    assign total = max_products
  endif

  assign shown = page_size
  if shown > total
    assign shown = total
  endif
-%}

<section class="bs-section" data-bs-root data-bs-step="{{ page_size }}">
  <div class="bs-inner">
    {%- comment -%}
      Guarded 2026-08-30: this interpolated the setting with no default and no blank check, so
      clearing the field in the theme editor rendered a literal empty <h2></h2>. Every sibling
      section already guards this; this one and florista-about were the two that did not.
    {%- endcomment -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="bs-heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if total > 0 -%}
      {%- comment -%} Real catalog. {%- endcomment -%}
      <noscript>
        <style>
          /* Not `revert` — that rolls back to the UA's own [hidden] rule, which
             is `display: none`, and the cards would stay hidden. */
          .bs-card[hidden] { display: block; }
          .bs-more { display: none; }
        </style>
      </noscript>

      <ul class="bs-grid">
        {%- for product in bs_collection.products limit: max_products -%}
          <li class="bs-card" data-bs-card {% if forloop.index > page_size %}hidden{% endif %}>
            <a class="bs-link" href="{{ product.url }}">
              {%- render 'florista-ribbon', product: product -%}
              <picture>
                {%- if product.featured_image -%}
                  {%- comment -%}
                    `alt: ''` here threw away the alt text the admin already holds on the real
                    product photo. Prefer the image's own alt; fall back to the product title
                    rather than to nothing. Fixed 2026-08-30. (Catalogue caveat: ~76 of 118
                    alt strings in the admin are still the product title verbatim — that is a
                    catalogue fix, not a theme one.)
                  {%- endcomment -%}
                  {%- liquid
                    assign card_alt = product.featured_image.alt
                    if card_alt == blank
                      assign card_alt = product.title
                    endif
                  -%}
                  {{
                    product.featured_image
                    | image_url: width: 900
                    | image_tag:
                      class: 'bs-img',
                      widths: '270, 400, 540, 700, 900',
                      sizes: '(min-width: 768px) 23vw, 45vw',
                      loading: 'lazy',
                      alt: card_alt
                  }}
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'bs-img' }}
                {%- endif -%}
              </picture>
              <p class="bs-name">{{ product.title }}</p>
              {% render 'florista-price', product: product, class: 'bs-price' %}
            </a>
          </li>
        {%- endfor -%}
      </ul>

      <p class="bs-count" data-bs-count aria-live="polite">
        מוצגים {{ shown }} מתוך {{ total }} מוצרים
      </p>

      <button
        type="button"
        class="bs-more"
        data-bs-more
        {% if shown >= total %}hidden{% endif %}
      >
        טעינת מוצרים נוספים
      </button>

    {%- else -%}
      {%- comment -%}
        Empty state. No collection, or the collection has no published products.
      {%- endcomment -%}
      {%- liquid
        assign placeholders = 'home-product-1|זר ורדים לבנים|189.90,home-product-2|זר ורדים ורודים|169.90,home-product-3|זר ורדים ופרחי בר|179.90,home-product-4|זר פרחים בגווני פסטל|159.90,home-product-5|זר אקליפטוס וורדים|199.90,home-product-6|סידור פרחים מיובשים|149.90,home-product-7|זר פרחים בסגנון בוהו|179.90,home-product-8|זר ורדים אדומים|189.90' | split: ','
      -%}

      <ul class="bs-grid">
        {%- for item in placeholders -%}
          {%- assign parts = item | split: '|' -%}
          {%- assign image = parts[0] -%}
          {%- assign name = parts[1] -%}
          {%- assign price = parts[2] -%}
          <li class="bs-card">
            <picture>
              <source type="image/webp" srcset="{{ image | append: '.webp' | asset_url }}">
              <img
                class="bs-img"
                src="{{ image | append: '.jpg' | asset_url }}"
                alt=""
                width="900"
                height="1125"
                loading="lazy"
              >
            </picture>
            <p class="bs-name">{{ name }}</p>
            <p class="bs-price"><bdi>₪{{ price }}</bdi></p>
          </li>
        {%- endfor -%}
      </ul>

      <button type="button" class="bs-more" disabled aria-disabled="true">
        טעינת מוצרים נוספים
      </button>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Florista best sellers",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "כותרת",
      "default": "המומלצים שלנו"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "קולקציה",
      "info": "ברירת מחדל: הקולקציה best-sellers. הסדר נקבע בסדר הקולקציה בממשק הניהול."
    },
    {
      "type": "range",
      "id": "page_size",
      "label": "מוצרים בכל טעינה",
      "min": 4,
      "max": 16,
      "step": 4,
      "default": 8
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "מקסימום מוצרים בסקשן",
      "min": 8,
      "max": 48,
      "step": 8,
      "default": 24
    }
  ],
  "presets": [{ "name": "Florista best sellers" }]
}
{% endschema %}
